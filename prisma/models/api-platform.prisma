model Invoice {
  id              String        @id @default(cuid())
  companyId       String        // TENANT SCOPE
  clientId        String?       // Link to CompanyContact (optional for now, migrate later)
  
  invoiceNumber   String
  clientName      String
  clientEmail     String
  clientCompany   String?
  clientAddress   String?       @db.Text

  status          InvoiceStatus @default(DRAFT)

  lineItems       String        @db.LongText         // JSON LineItem[]
  subtotal        Decimal       @db.Decimal(10,2)
  taxRate         Decimal       @db.Decimal(5,2)     @default(20)
  taxAmount       Decimal       @db.Decimal(10,2)
  total           Decimal       @db.Decimal(10,2)
  currency        String        @default("GBP")

  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  paymentRef      String?

  notes           String?       @db.Text
  metadata        String?       @db.Text             // JSON

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          CompanyContact? @relation(fields: [clientId], references: [id])

  @@map("invoices")
  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([clientEmail])
  @@index([createdAt])
}


enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
  CANCELLED
}

// -----------------------------------------------------------------------------
// COMPANY MEDIA ASSETS — Tenant-scoped media library
// -----------------------------------------------------------------------------
model CompanyMediaAsset {
  id           String    @id @default(cuid())
  companyId    String                                // TENANT SCOPE

  filename     String
  originalName String
  url          String    @db.Text
  cloudinaryId String?
  mimeType     String
  size         Int
  alt          String?
  tags         String?   @db.Text                   // JSON string[]

  uploadedBy   String?                              // userId

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_media_assets")
  @@index([companyId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// FORM SUBMISSIONS — Generic catch-all for any form on company sites
// -----------------------------------------------------------------------------
model FormSubmission {
  id          String    @id @default(cuid())
  companyId   String                                 // TENANT SCOPE

  formId      String                                 // e.g. "contact" | "newsletter" | "quote"
  data        String    @db.LongText                // JSON — arbitrary form fields
  ipAddress   String?
  userAgent   String?
  source      String?
  isRead      Boolean   @default(false)

  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("form_submissions")
  @@index([companyId])
  @@index([formId])
  @@index([isRead])
  @@index([createdAt])
}
